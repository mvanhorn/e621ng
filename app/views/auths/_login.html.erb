<div class="auth-flow-wrapper">
  <%= simple_form_for(:session, url: session_path, html: { id: "auth-login-form", class: "auth-form auth-login" }) do |f| %>
    <h1>Sign in</h1>
    <%= f.input(:url, as: :hidden, input_html: { value: params[:url] }) %>
    <%= f.input(:name, label: "Username", autofocus: true) %>
    <%= f.input(:password) %>
    <%= f.input(:remember, as: :boolean, input_html: { checked: "checked" }) %>
    <%= f.submit("Continue") %>
  <% end %>
</div>
